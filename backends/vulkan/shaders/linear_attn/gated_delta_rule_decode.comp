#version 450
// GATED_DELTANET recurrent decode over T rows (DECISIONS D-004 item 6; C-1 state slots).
//
// Per value head j (one workgroup), key head kh = j % n_k (GGUF tiled order, D-004 item 5),
// for t = 0..T-1:
//   S *= exp(g[t,j]);  kv = S^T k_t;  delta = (v_t - kv) * beta[t,j];  S += k_t delta^T;
//   o_t = S^T q_t
// A state is [n_v, d_k, d_v] fp32, element (j, a, b) at (j*d_k + a)*d_v + b. Column b of
// S depends only on column b, so thread t owns columns b = t, t+WG, ... for all rows — no
// cross-thread reduction, and each thread only re-reads state it wrote itself.
// Row 0 reads the input state region; later rows read the output region (already holding
// the previous row's state). Slot s (s < min(T, n_slots)) receives the state after row
// T-1-s. q and k are the RAW per-head rows (DECISIONS D-016): when qk_l2norm is set
// both are L2-normalized here, x * 1/sqrt(sum(x^2) + 1e-6) (sum of squares: strided
// partials + a fixed-order tree, so deterministic), then q *= q_scale. Nothing else is
// applied; k is never scaled. g is the log-decay (exp applied here); beta is already
// sigmoid-activated.
//
// state_in and state_out may be the same buffer (host guarantees identical or disjoint
// regions). With identical regions each element is read through state_in strictly before
// the same invocation writes it through state_out, and never read through state_in again.
#include "halo_common.glsl"

layout(constant_id = 0) const uint WG = 128;
layout(constant_id = 1) const uint MAX_DK = 256;
layout(local_size_x_id = 0) in;

layout(std430, binding = 0) readonly buffer Q { float q[]; };
layout(std430, binding = 1) readonly buffer K { float k[]; };
layout(std430, binding = 2) readonly buffer V { float v[]; };
layout(std430, binding = 3) readonly buffer G { float g[]; };
layout(std430, binding = 4) readonly buffer Beta { float beta[]; };
layout(std430, binding = 5) readonly buffer StateIn { float state_in[]; };
layout(std430, binding = 6) buffer StateOut { float state_out[]; };
layout(std430, binding = 7) writeonly buffer Out { float o[]; };
layout(std430, binding = 8) writeonly buffer Slots { float slots[]; };

layout(push_constant) uniform Push {
    uint n_v;
    uint n_k;
    uint d_k;
    uint d_v;
    uint n_tokens;
    uint n_slots;
    uint in_off;     // element offset of the input state (ring: of slot 0 of the slab)
    uint out_off;    // element offset of the output state (unused in ring mode)
    uint slots_off;  // element offset of slot 0 (unused in ring mode)
    uint qk_l2norm;  // 1: L2-normalize q and k per head (eps 1e-6) before use (D-016)
    float q_scale;   // q *= q_scale after the optional normalization (D-016)
    // Operand views (code review S-1), in float elements: sub-alignment remainder of the
    // view and the distance between consecutive tokens (rows).
    uint q_off, q_stride, k_off, k_stride, v_off, v_stride;
    uint g_off, g_stride, b_off, b_stride, o_off, o_stride;
    // State ring (ADR-001 §5.3): ring_p != 0 -> the three state bindings all name the slab
    // of ring_p dense states; the input is slab[ring_live], the final state goes to
    // slab[(ring_live+1) mod ring_p], logical slot s to slab[(ring_live+1+s) mod ring_p].
    uint ring_p, ring_live;
    // Columns of d_v per workgroup: the grid is n_v * ceil(d_v / dv_tile) groups (group
    // g -> head g / tiles, column tile g % tiles). Columns are independent, so the split is
    // bitwise-neutral; it only raises the number of workgroups in flight (n_v alone is 48).
    uint dv_tile;
} pc;

shared float sq[MAX_DK];
shared float sk[MAX_DK];
shared float red_q[WG];
shared float red_k[WG];

void main() {
    const uint gid = halo_group_id();
    const uint n_tiles = (pc.d_v + pc.dv_tile - 1u) / pc.dv_tile;
    const uint j = gid / n_tiles;
    if (j >= pc.n_v) return;
    const uint b_lo = (gid % n_tiles) * pc.dv_tile;
    const uint b_hi = min(b_lo + pc.dv_tile, pc.d_v);
    const uint tid = gl_LocalInvocationID.x;
    const uint kh = j % pc.n_k;
    const uint head = j * pc.d_k * pc.d_v;              // head offset inside one state
    const uint state_elems = pc.n_v * pc.d_k * pc.d_v;
    const bool ring = pc.ring_p != 0u;
    const uint sin_off = ring ? pc.in_off + pc.ring_live * state_elems : pc.in_off;
    const uint sout_off = ring ? pc.in_off + ((pc.ring_live + 1u) % pc.ring_p) * state_elems : pc.out_off;
    uint p2 = 1u;  // smallest power of two >= WG
    while (p2 < WG) p2 <<= 1;

    for (uint t = 0u; t < pc.n_tokens; ++t) {
        barrier();  // previous row finished with sq/sk/red_*
        const uint q_row = pc.q_off + t * pc.q_stride + kh * pc.d_k;
        const uint k_row = pc.k_off + t * pc.k_stride + kh * pc.d_k;
        float pq = 0.0;
        float pk = 0.0;
        for (uint a = tid; a < pc.d_k; a += WG) {
            const float qa = q[q_row + a];
            const float ka = k[k_row + a];
            sq[a] = qa;
            sk[a] = ka;
            pq += qa * qa;
            pk += ka * ka;
        }
        red_q[tid] = pq;
        red_k[tid] = pk;
        barrier();
        // Fixed-order tree over WG partials (WG need not be a power of two).
        for (uint s = p2 / 2u; s > 0u; s >>= 1) {
            if (tid < s && tid + s < WG) {
                red_q[tid] += red_q[tid + s];
                red_k[tid] += red_k[tid + s];
            }
            barrier();
        }
        const bool l2 = pc.qk_l2norm != 0u;
        const float inv_q = l2 ? 1.0 / sqrt(red_q[0] + 1e-6) : 1.0;
        const float inv_k = l2 ? 1.0 / sqrt(red_k[0] + 1e-6) : 1.0;
        for (uint a = tid; a < pc.d_k; a += WG) {
            sq[a] = (sq[a] * inv_q) * pc.q_scale;
            sk[a] = sk[a] * inv_k;
        }
        barrier();

        const float decay = exp(g[pc.g_off + t * pc.g_stride + j]);
        const float bt = beta[pc.b_off + t * pc.b_stride + j];
        const uint vrow = pc.v_off + t * pc.v_stride + j * pc.d_v;
        const uint orow = pc.o_off + t * pc.o_stride + j * pc.d_v;
        const bool first = t == 0u;
        const uint slot = pc.n_tokens - 1u - t;  // slot this row's state belongs to
        const bool to_slot = slot < pc.n_slots;
        const uint slot_base = (ring ? pc.in_off + ((pc.ring_live + 1u + slot) % pc.ring_p) * state_elems
                                     : pc.slots_off + slot * state_elems) + head;

        for (uint b = b_lo + tid; b < b_hi; b += WG) {
            float kv = 0.0;
            for (uint a = 0u; a < pc.d_k; ++a) {
                const uint e = head + a * pc.d_v + b;
                const float s0 = first ? state_in[sin_off + e] : state_out[sout_off + e];
                kv += (s0 * decay) * sk[a];
            }
            const float delta = (v[vrow + b] - kv) * bt;
            float acc = 0.0;
            for (uint a = 0u; a < pc.d_k; ++a) {
                const uint e = head + a * pc.d_v + b;
                const float s0 = first ? state_in[sin_off + e] : state_out[sout_off + e];
                const float s = s0 * decay + sk[a] * delta;
                state_out[sout_off + e] = s;
                if (to_slot) slots[slot_base + a * pc.d_v + b] = s;
                acc += s * sq[a];
            }
            o[orow + b] = acc;
        }
    }
}
