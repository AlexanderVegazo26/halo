#version 450
// RMS_NORM: y[r,i] = (x[r,i] * (1 / sqrt(mean(x[r,:]^2) + eps))) * w[i]   (plain x̂·w, D-004;
// same operation order as cpu::rms_norm). One workgroup per row; fixed-order shared-memory
// tree reduction (deterministic). Operands are views (element offset remainder + row
// stride from the host, code review S-1).
// The sum of squares, the tree, inv and the scaled product come from common/rms_norm_tree.glsl, which
// common/matvec_normed.glsl uses too: HALO_FUSE_NORM relies on the two being bit for bit equal
// (VkHead.GemvFusedNorm*), and hand copies drifted apart once (1 ulp, 2026-11-14).
#include "halo_common.glsl"
#include "rms_norm_tree.glsl"

layout(constant_id = 0) const uint WG = 256;  // power of two (host-validated)
layout(local_size_x_id = 0) in;

layout(std430, binding = 0) readonly buffer X { float x[]; };
layout(std430, binding = 1) readonly buffer Wt { float w[]; };
layout(std430, binding = 2) writeonly buffer Y { float y[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint cols;
    float eps;
    uint x_off;
    uint x_stride;
    uint w_off;
    uint y_off;
    uint y_stride;
} pc;

shared float red[WG];

void main() {
    const uint row = halo_group_id();
    if (row >= pc.rows) return;
    const uint tid = gl_LocalInvocationID.x;
    const uint xb = pc.x_off + row * pc.x_stride;
    const uint yb = pc.y_off + row * pc.y_stride;

    HALO_RMS_LANE_SUM(red, tid, WG, pc.cols, i, x[xb + i])
    HALO_RMS_TREE_REDUCE_WG(red, tid, WG)
    const float inv = halo_rms_inv(red[0], pc.cols, pc.eps);
    for (uint i = tid; i < pc.cols; i += WG) {
        y[yb + i] = halo_rms_scale(x[xb + i], inv, w[pc.w_off + i]);
    }
}
