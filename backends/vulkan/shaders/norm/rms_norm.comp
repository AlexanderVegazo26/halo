#version 450
// RMS_NORM: y[r,i] = (x[r,i] * (1 / sqrt(mean(x[r,:]^2) + eps))) * w[i]   (plain x̂·w, D-004;
// same operation order as cpu::rms_norm). One workgroup per row; fixed-order shared-memory
// tree reduction (deterministic). Operands are views (element offset remainder + row
// stride from the host, code review S-1).
// The sum of squares, inv and the scaled product are `precise`: left free, the compiler contracted and
// rewrote them differently here and in matmul/matvec_*_normed.comp (1 ulp apart), and HALO_FUSE_NORM
// relies on the two being bit for bit equal (VkHead.GemvFusedNorm*).
#include "halo_common.glsl"

layout(constant_id = 0) const uint WG = 256;  // power of two (host-validated)
layout(local_size_x_id = 0) in;

layout(std430, binding = 0) readonly buffer X { float x[]; };
layout(std430, binding = 1) readonly buffer Wt { float w[]; };
layout(std430, binding = 2) writeonly buffer Y { float y[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint cols;
    float eps;
    uint x_off;
    uint x_stride;
    uint w_off;
    uint y_off;
    uint y_stride;
} pc;

shared float red[WG];

void main() {
    const uint row = halo_group_id();
    if (row >= pc.rows) return;
    const uint tid = gl_LocalInvocationID.x;
    const uint xb = pc.x_off + row * pc.x_stride;
    const uint yb = pc.y_off + row * pc.y_stride;

    precise float acc = 0.0;
    for (uint i = tid; i < pc.cols; i += WG) {
        const float v = x[xb + i];
        acc += v * v;
    }
    red[tid] = acc;
    barrier();
    for (uint s = WG / 2u; s > 0u; s >>= 1) {
        if (tid < s) red[tid] += red[tid + s];
        barrier();
    }
    precise float inv = 1.0 / sqrt(red[0] / float(pc.cols) + pc.eps);
    for (uint i = tid; i < pc.cols; i += WG) {
        precise float r = (x[xb + i] * inv) * w[pc.w_off + i];
        y[yb + i] = r;
    }
}
