#version 450
// [ADD + RMS_NORM] h = a + b (IEEE add, = cpu::add), then y = (h * inv) * w with inv from
// the rms_norm kernel's reduction over h (same order, so y == Ops::rms_norm(h) bitwise).
// h may alias a or b exactly: each invocation reads a[i], b[i] and then writes h[i]; the
// normalisation re-reads only h values this invocation wrote.
// The sum of squares, the tree, inv and the scaled product come from common/rms_norm_tree.glsl, which
// common/matvec_normed.glsl uses too: HALO_FUSE_NORM relies on the two being bit for bit equal
// (VkHead.GemvFusedNorm*), and hand copies drifted apart once (1 ulp, 2026-11-14).
#include "halo_common.glsl"
#include "rms_norm_tree.glsl"

layout(constant_id = 0) const uint WG = 256;  // power of two (host-validated)
layout(local_size_x_id = 0) in;

layout(std430, binding = 0) readonly buffer A { float a[]; };
layout(std430, binding = 1) readonly buffer B { float b[]; };
layout(std430, binding = 2) buffer H { float h[]; };
layout(std430, binding = 3) readonly buffer Wt { float w[]; };
layout(std430, binding = 4) writeonly buffer Y { float y[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint cols;
    float eps;
    uint a_off, a_stride, b_off, b_stride, h_off, h_stride, w_off, y_off, y_stride;
} pc;

shared float red[WG];

void main() {
    const uint row = halo_group_id();
    if (row >= pc.rows) return;
    const uint tid = gl_LocalInvocationID.x;
    const uint ab = pc.a_off + row * pc.a_stride;
    const uint bb = pc.b_off + row * pc.b_stride;
    const uint hb = pc.h_off + row * pc.h_stride;
    const uint yb = pc.y_off + row * pc.y_stride;
    // h[hb + i] = a + b is stored here, inside the sum's LOAD: a[i] and b[i] are read before h[i]
    // is written (the aliasing contract above), and the sum of squares takes the stored value.
    HALO_RMS_LANE_SUM(red, tid, WG, pc.cols, i, h[hb + i] = a[ab + i] + b[bb + i])
    HALO_RMS_TREE_REDUCE_WG(red, tid, WG)
    const float inv = halo_rms_inv(red[0], pc.cols, pc.eps);
    for (uint i = tid; i < pc.cols; i += WG) {
        y[yb + i] = halo_rms_scale(h[hb + i], inv, w[pc.w_off + i]);
    }
}
