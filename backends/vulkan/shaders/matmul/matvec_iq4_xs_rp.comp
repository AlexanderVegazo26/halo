#version 450
// QUANT_GEMV / MATMUL, ggml IQ4_XS weights REPACKED into planar 16-byte-aligned rows
// (halo/tensor/repack.h; gemv variant kGemvRepacked, opt-in HALO_REPACK=1). Body:
// common/matvec_iq4_xs_rp_main.glsl -- the matvec_iq4_xs.comp arithmetic with one aligned
// uvec4 load per thread for its qs. Only valid for weights produced by tensor::gemv_repack;
// the host never routes raw GGUF blocks here and every row start (binding remainder + row *
// stride) is 16-byte aligned.
#include "halo_common.glsl"

layout(constant_id = 0) const uint WG = 256;
layout(local_size_x_id = 0) in;

// One storage buffer, two views (same binding, as llama.cpp's *_packed aliases).
layout(std430, binding = 0) readonly buffer Wq2 { uvec2 wq2[]; };
layout(std430, binding = 0) readonly buffer Wq4 { uvec4 wq4[]; };
layout(std430, binding = 1) readonly buffer X { float x[]; };
layout(std430, binding = 2) writeonly buffer Y { float y[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint cols;
    uint n_vec;     // 1..MAX_VEC
    uint w_off;     // sub-alignment remainder of the W view (bytes; multiple of 16)
    uint w_stride;  // row stride of W (bytes; multiple of 16)
    uint x_off, x_stride, y_off, y_stride;  // element remainders / vector strides (S-1)
} pc;

// Specialization constant 1 (host: 0 when n_vec == 1): see matvec_quant_main.glsl.
layout(constant_id = 1) const uint BATCHED = 1;
const uint MAX_VEC = 8u;

shared float red[WG];
shared float redb[BATCHED != 0u ? MAX_VEC * WG : 1u];  // batched reduction (all vectors at once)

// kvalues_iq4nl staged in shared memory (llama's init_iq_shmem): dynamic indexing into a
// const array lowers to scratch loads on ACO; LDS lookups are ~1 op each.
shared int sh_kv[16];

// ggml kvalues_iq4nl (ggml-common.h, MIT)
const int KVALUES[16] = int[16](-127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113);

struct QI4Block {
    uvec4 qsw;     // the sub-block's 4 packed qs words (32 nibbles)
    float dscale;  // d * (scale - 32), hoisted to one fma per sub-block
};

#define IQ4_FN rp
#include "matvec_iq4_xs_rp_main.glsl"
#undef IQ4_FN

void main() {
    const uint row = halo_group_id();
    if (row >= pc.rows) return;
    if (gl_LocalInvocationID.x < 16u) sh_kv[gl_LocalInvocationID.x] = KVALUES[gl_LocalInvocationID.x];
    barrier();
    iq4_rp(row, pc.w_off + row * pc.w_stride);
}
