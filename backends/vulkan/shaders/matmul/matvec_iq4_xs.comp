#version 450
#include "matvec_variant_prologue.glsl"
// QUANT_GEMV / MATMUL, ggml IQ4_XS weights: y[t][r] = sum_c W[r,c] * x[t][c]. Per-type
// main: common/matvec_iq4_xs_main.glsl (llama.cpp mul_mat_vec_iq4_xs port: 8
// threads/block, SWAR dequant, sub-block scale hoisting; shared with neither the other
// matvec types nor get_rows_iq4_xs, which keep common/dequant_iq4_xs.glsl). The body is
// instantiated twice: FAST reads the (4-aligned) weight words directly; SLOW handles
// arbitrary byte offsets (VkViews arena gate) via HALO_DEFINE_BYTE_READERS with identical
// integer content, so both produce bitwise-identical results.
// NORMED variant matvec_iq4_xs_normed (opt-in HALO_FUSE_NORM=1, decode n_vec == 1 only): this file
// compiled with -DHALO_FUSE_NORM (backends/vulkan/CMakeLists.txt): y = W * (rms_norm(x) * nw), the
// per-type main's input reads go through HALO_X; prologue in common/matvec_normed.glsl.
// SUBGROUP variant matvec_iq4_xs_sg (opt-in HALO_SUBGROUP_REDUCE=1; the host then runs it for EVERY
// chunk, n_vec == 1 included, see ops.cpp): this file compiled with -DHALO_SUBGROUP_REDUCE: the
// dequant/apply code is common/matvec_iq4_xs_main.glsl, but the cross-thread reduction
// is subgroupAdd (+ a shared step when the workgroup spans several subgroups) with the chunk's
// vector count as the specialization constant NV, see common/matvec_sg_reduce.glsl and
// matvec_iq4_xs_sg_main.glsl (which the _main.glsl includes at its end in this build). Not
// bitwise equal to the plain build (reduction order).
#include "halo_common.glsl"

layout(constant_id = 0) const uint WG = 256;
layout(local_size_x_id = 0) in;

#include "matvec_io.glsl"  // Wq/X(or XR+NW)/Y bindings + push block

#ifdef HALO_SUBGROUP_REDUCE
// Not a specialization constant here: only the (unused) tree bodies of the included main read it.
const uint BATCHED = 0u;
#else
// Specialization constant 1 (host: 0 when n_vec == 1): see matvec_quant_main.glsl.
layout(constant_id = 1) const uint BATCHED = 1;
#endif
const uint MAX_VEC = 8u;

#ifdef HALO_FUSE_NORM
// HALO_FUSE_NORM prologue: norm_prologue() + HALO_X (input normalized as it is read).
#include "matvec_normed.glsl"
#endif

shared float red[WG];
shared float redb[BATCHED != 0u ? MAX_VEC * WG : 1u];  // batched reduction (all vectors at once)

// kvalues_iq4nl staged in shared memory (llama's init_iq_shmem): dynamic indexing into a
// const array lowers to scratch loads on ACO; LDS lookups are ~1 op each.
shared int sh_kv[16];

HALO_DEFINE_BYTE_READERS(wq)

#ifdef HALO_SUBGROUP_REDUCE
#include "matvec_sg_reduce.glsl"
#endif

// ggml kvalues_iq4nl (ggml-common.h, MIT)
const int KVALUES[16] = int[16](-127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113);

struct QI4Block {
    uvec4 qsw;     // the sub-block's 4 packed qs words (32 nibbles)
    float dscale;  // d * (scale - 32), hoisted to one fma per sub-block
};

#define LD32(bo) (wq[(bo) >> 2])
#define IQ4_FN fast
#include "matvec_iq4_xs_main.glsl"
#undef LD32
#undef IQ4_FN

#define LD32(bo) \
    (read_u8(bo) | (read_u8((bo) + 1u) << 8) | (read_u8((bo) + 2u) << 16) | (read_u8((bo) + 3u) << 24))
#define IQ4_FN slow
#include "matvec_iq4_xs_main.glsl"
#undef LD32
#undef IQ4_FN

void main() {
    const uint row = halo_group_id();
    if (row >= pc.rows) return;
#ifdef HALO_FUSE_NORM
    norm_prologue();
#endif
    if (gl_LocalInvocationID.x < 16u) sh_kv[gl_LocalInvocationID.x] = KVALUES[gl_LocalInvocationID.x];
    barrier();
    const uint row_off = pc.w_off + row * pc.w_stride;
    // Uniform branch: 136-byte blocks keep every row at the same alignment as w_off.
    if ((row_off & 3u) == 0u)
        HALO_MV_ENTRY(iq4, fast)(row, row_off);
    else
        HALO_MV_ENTRY(iq4, slow)(row, row_off);
}
