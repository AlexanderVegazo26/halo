#version 450
// QUANT_GEMV / MATMUL, ggml IQ4_XS weights: y[t][r] = sum_c W[r,c] * x[t][c]. Per-type
// main: common/matvec_iq4_xs_main.glsl (llama.cpp mul_mat_vec_iq4_xs port: 8
// threads/block, SWAR dequant, sub-block scale hoisting; shared with neither the other
// matvec types nor get_rows_iq4_xs, which keep common/dequant_iq4_xs.glsl). The body is
// instantiated twice: FAST reads the (4-aligned) weight words directly; SLOW handles
// arbitrary byte offsets (VkViews arena gate) via HALO_DEFINE_BYTE_READERS with identical
// integer content, so both produce bitwise-identical results.
#include "halo_common.glsl"

layout(constant_id = 0) const uint WG = 256;
layout(local_size_x_id = 0) in;

layout(std430, binding = 0) readonly buffer Wq { uint wq[]; };
layout(std430, binding = 1) readonly buffer X { float x[]; };
layout(std430, binding = 2) writeonly buffer Y { float y[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint cols;
    uint n_vec;     // 1..MAX_VEC
    uint w_off;     // sub-alignment remainder of the W view (bytes)
    uint w_stride;  // row stride of W (bytes)
    uint x_off, x_stride, y_off, y_stride;  // element remainders / vector strides (S-1)
} pc;

// Specialization constant 1 (host: 0 when n_vec == 1): see matvec_quant_main.glsl.
layout(constant_id = 1) const uint BATCHED = 1;
const uint MAX_VEC = 8u;

shared float red[WG];

// kvalues_iq4nl staged in shared memory (llama's init_iq_shmem): dynamic indexing into a
// const array lowers to scratch loads on ACO; LDS lookups are ~1 op each.
shared int sh_kv[16];

HALO_DEFINE_BYTE_READERS(wq)

// ggml kvalues_iq4nl (ggml-common.h, MIT)
const int KVALUES[16] = int[16](-127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113);

struct QI4Block {
    uvec4 qsw;     // the sub-block's 4 packed qs words (32 nibbles)
    float dscale;  // d * (scale - 32), hoisted to one fma per sub-block
};

#define LD32(bo) (wq[(bo) >> 2])
#define IQ4_FN fast
#include "matvec_iq4_xs_main.glsl"
#undef LD32
#undef IQ4_FN

#define LD32(bo) \
    (read_u8(bo) | (read_u8((bo) + 1u) << 8) | (read_u8((bo) + 2u) << 16) | (read_u8((bo) + 3u) << 24))
#define IQ4_FN slow
#include "matvec_iq4_xs_main.glsl"
#undef LD32
#undef IQ4_FN

void main() {
    const uint row = halo_group_id();
    if (row >= pc.rows) return;
    if (gl_LocalInvocationID.x < 16u) sh_kv[gl_LocalInvocationID.x] = KVALUES[gl_LocalInvocationID.x];
    barrier();
    const uint row_off = pc.w_off + row * pc.w_stride;
    // Uniform branch: 136-byte blocks keep every row at the same alignment as w_off.
    if ((row_off & 3u) == 0u)
        iq4_fast(row, row_off);
    else
        iq4_slow(row, row_off);
}
