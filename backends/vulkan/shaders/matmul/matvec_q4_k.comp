#version 450
#include "matvec_variant_prologue.glsl"
// QUANT_GEMV / MATMUL, ggml Q4_K weights: y[t][r] = sum_c W[r,c] * x[t][c]. Per-type main:
// common/matvec_q4_k_main.glsl (llama.cpp mul_mat_vec_q4_k port: 16 threads/block, SWAR
// dequant, sub-block scale application; shared with neither the other matvec types nor
// get_rows_q4_k, which keep common/dequant_q4_k.glsl). The body is instantiated twice:
// FAST reads the (4-aligned) weight words directly; SLOW handles arbitrary byte offsets
// (VkViews arena gate) via HALO_DEFINE_BYTE_READERS with identical integer content, so
// both produce bitwise-identical results.
// NORMED variant matvec_q4_k_normed (opt-in HALO_FUSE_NORM=1, decode n_vec == 1 only): this file
// compiled with -DHALO_FUSE_NORM (backends/vulkan/CMakeLists.txt): y = W * (rms_norm(x) * nw), the
// per-type main's input reads go through HALO_X; prologue in common/matvec_normed.glsl.
// SUBGROUP variant matvec_q4_k_sg (opt-in HALO_SUBGROUP_REDUCE=1; the host then runs it for EVERY
// chunk, n_vec == 1 included, see ops.cpp): this file compiled with -DHALO_SUBGROUP_REDUCE: the
// dequant/apply code is common/matvec_q4_k_main.glsl, but the cross-thread reduction
// is subgroupAdd (+ a shared step when the workgroup spans several subgroups) with the chunk's
// vector count as the specialization constant NV, see common/matvec_sg_reduce.glsl and
// matvec_q4_k_sg_main.glsl (which the _main.glsl includes at its end in this build). Not
// bitwise equal to the plain build (reduction order).
#include "halo_common.glsl"

layout(constant_id = 0) const uint WG = 256;
layout(local_size_x_id = 0) in;

#include "matvec_io.glsl"  // Wq/X(or XR+NW)/Y bindings + push block

#ifndef HALO_SUBGROUP_REDUCE
// Tree-reduction build only: the HALO_SUBGROUP_REDUCE build compiles no tree body (see the
// per-type _main.glsl) and takes its vector count from NV (common/matvec_sg_reduce.glsl).
// Specialization constant 1 (host: 0 when n_vec == 1): see matvec_quant_main.glsl.
layout(constant_id = 1) const uint BATCHED = 1;
const uint MAX_VEC = 8u;
#endif

#ifdef HALO_FUSE_NORM
// HALO_FUSE_NORM prologue: norm_prologue() + HALO_X (input normalized as it is read).
#include "matvec_normed.glsl"
#endif

#ifndef HALO_SUBGROUP_REDUCE
#include "matvec_tree_reduce.glsl"  // tree_finish1() / tree_finish()
#endif

HALO_DEFINE_BYTE_READERS(wq)

#ifdef HALO_SUBGROUP_REDUCE
#include "matvec_sg_reduce.glsl"
#endif

struct Q4KBlock {
    vec4 qA, qB, qC, qD;  // q nibbles: elements y_off+{0..3}, +32, and +128/+160
    vec2 dm;              // (d, dmin)
    vec4 sc_lo;           // sc0, sc1, m0, m1 (sub-blocks 2*v_im, 2*v_im+1)
    vec4 sc_hi;           // sc4, sc5, m4, m5 (sub-blocks 2*v_im+4, 2*v_im+5)
};

#define LD32(bo) (wq[(bo) >> 2])
#define Q4K_FN fast
#include "matvec_q4_k_main.glsl"
#undef LD32
#undef Q4K_FN

#define LD32(bo) \
    (read_u8(bo) | (read_u8((bo) + 1u) << 8) | (read_u8((bo) + 2u) << 16) | (read_u8((bo) + 3u) << 24))
#define Q4K_FN slow
#include "matvec_q4_k_main.glsl"
#undef LD32
#undef Q4K_FN

void main() {
    const uint row = halo_group_id();
    if (row >= pc.rows) return;
#ifdef HALO_FUSE_NORM
    norm_prologue();
#endif
    const uint row_off = pc.w_off + row * pc.w_stride;
    // Uniform branch: 144-byte blocks keep every row at the same alignment as w_off.
    if ((row_off & 3u) == 0u)
        HALO_MV_ENTRY(q4k, fast)(row, row_off);
    else
        HALO_MV_ENTRY(q4k, slow)(row, row_off);
}
