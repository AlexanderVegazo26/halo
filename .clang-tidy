# clang-tidy gate for halo's own code (src/ and include/halo/). Run it with scripts/clang-tidy;
# CI's `clang-tidy` job runs the same script with the same pinned clang-tidy.
#
# Every enabled check is an error: a new finding fails the job. Two kinds of checks are off:
#   * off for good: style rules that don't find bugs in this codebase (see the reason per check);
#   * RATCHET: checks that still have findings in src/ (count as of 2026-11-07). Fix a check's
#     findings (or NOLINT a false positive with its reason), then delete its line here so the
#     gate holds it at zero from then on. Never add a check to this list to get a red run green.
Checks: >-
  -*,
  bugprone-*,
  clang-analyzer-*,
  performance-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-signed-bitwise,
  -performance-enum-size,
  -clang-analyzer-optin.performance.Padding,
  -bugprone-unchecked-optional-access
# Why each one is off (same order as above):
#   off for good:
#     easily-swappable-parameters    kernel signatures are (rows, cols, ...) by design
#     narrowing-conversions          -Wconversion already covers it, with the casts reviewed
#     implicit-widening-of-mult...   size_t index arithmetic everywhere; -Wconversion covers it
#     signed-bitwise                 315 hits, all bit packing on fixed-width ints (quant formats)
#     enum-size                      23 hits, enum width doesn't matter here
#     optin Padding                  struct layout follows the GGUF/kernel structs
#   RATCHET (findings left in src/ on 2026-11-07):
#     unchecked-optional-access 12 (30 on 2026-11-07; left in qwen35.cpp 6, speculative.cpp 6)
#   (fixed and gated since: unnecessary-copy-initialization, std-exception-baseclass,
#    signed-char-misuse, return-const-ref-from-parameter, optional-value-conversion,
#    misplaced-widening-cast, branch-clone, use-std-move, unnecessary-value-param,
#    move-const-arg, suspicious-stringview-data-usage, assignment-in-if-condition,
#    inefficient-vector-operation, faster-string-find, prefer-single-char-overloads,
#    inefficient-string-concatenation, exception-escape, empty-catch,
#    casting-through-void)
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(src|include/halo)/.*'
ExcludeHeaderFilterRegex: '.*/_deps/.*'
SystemHeaders: false
