+// Adds n to counter; throws when the (non-zero) limit would be exceeded.
+inline void budget_add(uint64_t & counter, uint64_t n, uint64_t limit, const char * what) {
+    if (limit != 0 && (n > limit || counter > limit - n)) throw_limit(what, limit);
+    counter += n;
+}
+
+inline void budget_steps(uint64_t n = 1) {
+    if (auto * b = current_budget) budget_add(b->steps, n, b->limits.max_steps, "step");
+}
+inline void budget_loop_iteration() {
+    if (auto * b = current_budget) budget_add(b->loop_iterations, 1, b->limits.max_loop_iterations, "loop iteration");
+}
+inline void budget_output(uint64_t n) {
+    if (auto * b = current_budget) budget_add(b->output_bytes, n, b->limits.max_output_bytes, "output size");
+}
+inline void budget_alloc(uint64_t n) {
+    if (auto * b = current_budget) budget_add(b->alloc_bytes, n, b->limits.max_alloc_bytes, "allocation");
