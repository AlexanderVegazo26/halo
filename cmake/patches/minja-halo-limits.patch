+// Charges a substring search over `hay` bytes for a needle of `needle` bytes (worst case hay*needle).
+inline void budget_search(uint64_t hay, uint64_t needle) {
+    if (!current_budget || needle <= 1) return;
+    const uint64_t cost = needle != 0 && hay > UINT64_MAX / needle ? UINT64_MAX : hay * needle;
