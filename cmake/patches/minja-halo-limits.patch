+    size_t max_depth = 0;              // nested node renders + expression evaluations + value traversals
+    uint64_t max_steps = 0;            // node renders + expression evaluations + charged builtin work
+    uint64_t max_loop_iterations = 0;  // for-loop iterations (filtering included)
+    uint64_t max_output_bytes = 0;     // bytes written by output nodes, summed over all nested streams
+    uint64_t max_string_bytes = 0;     // largest single string (bytes) or container (elements) an operation may build
+    uint64_t max_alloc_bytes = 0;      // cumulative bytes of string values created or copied, plus container slots
+};
+
+class LimitExceeded : public std::runtime_error {
+  public:
