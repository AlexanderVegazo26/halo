+// Throws if an operation is about to build a string of n bytes (or a container of n elements).
+inline void budget_size(uint64_t n) {
+    auto * b = current_budget;
+    if (b && b->limits.max_string_bytes != 0 && n > b->limits.max_string_bytes) throw_limit("value size", b->limits.max_string_bytes);
